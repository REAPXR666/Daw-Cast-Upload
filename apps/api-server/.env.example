NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://dawcast:dawcast_dev_password@localhost:5432/dawcast?schema=public"
REDIS_URL="redis://localhost:6379"

# Generate real random secrets before ever deploying this beyond local dev.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000

CORS_ORIGIN="http://localhost:5173"

REPORT_UPLOADS_DIR="./uploads/reports"

# Billing is fully optional — omit these and the app runs fine with everyone
# on the free tier. Set all three to enable real Stripe Checkout/Portal/webhooks.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID="price_..."
# STRIPE_SUCCESS_URL="https://yourdomain.com/billing/success"
# STRIPE_CANCEL_URL="https://yourdomain.com/billing/cancel"

# TLS is optional — omit both and the server runs plain HTTP (fine for local
# dev). Set both to real PEM file paths to terminate HTTPS directly in Node,
# no reverse proxy required.
# TLS_CERT_PATH="C:\daw-cast\tls\fullchain.pem"
# TLS_KEY_PATH="C:\daw-cast\tls\privkey.pem"
