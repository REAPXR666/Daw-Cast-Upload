NODE_ENV=development
PORT=4001

DATABASE_URL="postgresql://dawcast:dawcast_dev_password@localhost:5432/dawcast?schema=public"
REDIS_URL="redis://localhost:6379"

# Must match api-server's JWT_ACCESS_SECRET — both services verify tokens
# issued by api-server against the same secret.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"

# For local single-machine testing, 127.0.0.1 is correct. For LAN testing
# across machines, set this to the host machine's LAN IP.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

CORS_ORIGIN="http://localhost:5173"

# Phase 1 hardcoded cap — becomes Stripe-tier-driven in Phase 4.
FREE_TIER_MAX_PARTICIPANTS=2
